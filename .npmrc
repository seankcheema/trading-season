# Suppress EBADENGINE warnings for version mismatches
# Jenkins has npm 11.6.0 installed; package.json specifies 11.16.0 as ideal
# but code is compatible with 11.6.0. This setting allows npm ci to proceed
# without warnings in CI environments where npm version cannot be changed.
engine-strict=false

# Disable funding notifications during CI builds
fund=false

# Prefer offline mode for faster, more reliable builds
prefer-offline=true
