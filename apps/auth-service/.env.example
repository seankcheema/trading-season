# Environment Variables for Auth Service
NODE_ENV=development
PORT=3001

# Auth database. Published on 5433 by docker-compose because 5432 is already
# taken by the application database. Inside Docker the host is auth-db:5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=authuser
DB_PASSWORD=changeme
DB_NAME=auth_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=3600

# CORS Configuration (if needed)
CORS_ORIGIN=http://localhost:3000
