# Environment Variables for Auth Service
NODE_ENV=development
PORT=3001

# The shared business database. This service has no database of its own: it
# reads and writes the credential columns of `users` and owns `refresh_tokens`,
# both inside trading_season. The schema is applied by Flyway from
# apps/business-backend/db/migrations before this service starts.
#
# Grant this role nothing on orders, fills, holdings or audit_trail.
# Inside Docker the host is db:5432.
DB_HOST=localhost
DB_PORT=5432
DB_USER=trading_season
DB_PASSWORD=changeme
DB_NAME=trading_season

# JWT Configuration — RS256, so this is a keypair, not a shared secret.
# Generate a development pair with:
#   node scripts/generate-dev-keys.mjs >> .env.local
# Keys use literal \n escapes so they survive .env, shells and docker-compose;
# JwtKeysService converts them back on load. The service refuses to start if
# either is missing — there is deliberately no fallback key.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=https://auth.dualeapa.local

# Origins allowed to call this service, comma-separated. Defaults to the
# Angular dev server if unset. An explicit list, never a wildcard: these
# routes hand out credentials.
CORS_ORIGINS=http://localhost:4200
