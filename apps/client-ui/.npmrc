# Suppress EBADENGINE warnings for version mismatches.
engine-strict=false

# Jenkins runs npm 11.6.0 (see the NodeJS tool config). packageManager
# below pins the same version so a locally regenerated lockfile matches
# what CI reads. This repo previously hit an `npm ci` EUSAGE "Missing: X
# from lock file" failure in Jenkins, on a lockfile that installed and
# built cleanly everywhere it was tried locally; the proximate trigger was
# a file: dependency on a sibling directory (see git history around
# apps/client-ui/shared-ui-components), which is now gone, not a version
# mismatch as such -- but matching npm versions removes one more variable.

# Disable funding notifications during CI builds
fund=false

# Prefer offline mode for faster, more reliable builds
prefer-offline=true
