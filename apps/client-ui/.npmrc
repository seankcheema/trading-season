# Suppress EBADENGINE warnings for version mismatches.
engine-strict=false

# A lockfile written by npm 11.16.0 locally failed Jenkins' `npm ci` (npm
# 11.6.0) with EUSAGE "Missing: @shared/ui-components@0.0.1 from lock
# file", even though that entry was present in the file. Diffing the two
# lockfiles, 11.16.0 adds a "libc" field (glibc/musl) to optional platform
# packages that 11.6.0 does not write; npm 11.6.0 apparently cannot read a
# lockfile carrying that field without failing its sync check elsewhere in
# the file. Related upstream reports on npm's lockfile-writing changes
# across this version range: https://github.com/npm/cli/issues/9433 and
# https://github.com/npm/cli/issues/10043.
#
# Regenerate this lockfile only with npm 11.6.0 (matching the
# packageManager field and the Jenkins NodeJS tool), e.g.
# `npx -y npm@11.6.0 --prefix apps/client-ui install`, until the Jenkins
# npm version is upgraded past this mismatch.

# Disable funding notifications during CI builds
fund=false

# Prefer offline mode for faster, more reliable builds
prefer-offline=true
