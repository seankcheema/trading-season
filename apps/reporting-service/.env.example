# Reporting Service Configuration

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=True

# Database Connection
DATABASE_URL=postgresql+psycopg://trading_season:password@localhost:5432/trading_season

# Auth Service Integration
AUTH_SERVICE_URL=http://localhost:3001
AUTH_JWT_ISSUER=http://localhost:3001
AUTH_JWT_AUDIENCE=trading-season-api

# Reporting Service
REPORTING_SERVICE_PORT=8083
REPORTING_SERVICE_HOST=0.0.0.0

# Report runs. Only the consumer process (python consumer.py) runs the
# scheduler; the web service is started with SCHEDULER_ENABLED=False.
SCHEDULER_ENABLED=True
SCHEDULER_INTERVAL_MINUTES=15

# Where the consumer writes trade events and report runs, and the web service
# reads them. Compose mounts the reporting_files volume at /data/reporting.
REPORTING_FILES_DIR=./data/reporting

# Kafka. The host-facing broker listener is localhost:29092; inside Compose it
# is kafka:9092. The group id must stay reporting-ingester so committed offsets
# carry across restarts.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TRADE_EVENTS_TOPIC=trade-events
REPORTING_CONSUMER_GROUP=reporting-ingester

# CORS
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
