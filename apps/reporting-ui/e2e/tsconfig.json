/* Type-checking for the Playwright suite. These specs run in Node through the
   Playwright runner, not in the browser bundle, so they are kept out of
   tsconfig.app.json and tsconfig.spec.json, and the playwright config that
   sits one level up is checked with them. */
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
