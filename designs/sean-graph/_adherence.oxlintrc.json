{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/market/**",
              "components/overlays/**",
              "ui_kits/_shared/**",
              "ui_kits/client-ui/**",
              "ui_kits/instrument-view/**",
              "ui_kits/reporting-ui/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo))/i]",
        "message": "Font not provided by the design system. Available: Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|radius|icon|iconEnd|fullWidth|disabled|loading|type|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, radius, icon, iconEnd, fullWidth, disabled, loading, type, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|outline|secondary|ghost|destructive|sell|glass|link)$/]",
        "message": "<Button> variant must be one of 'default' | 'outline' | 'secondary' | 'ghost' | 'destructive' | 'sell' | 'glass' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|default|lg|cta|icon|icon-sm|icon-lg)$/]",
        "message": "<Button> size must be one of 'xs' | 'sm' | 'default' | 'lg' | 'cta' | 'icon' | 'icon-sm' | 'icon-lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|radius|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: size, radius, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm)$/]",
        "message": "<Card> size must be one of 'default' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChangePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|tone|tag|children|style|key|ref|className|style|children)$/]",
        "message": "<ChangePill> doesn't accept that prop. Declared props: value, tone, tag, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChangePill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gain|loss|primary|muted)$/]",
        "message": "<ChangePill> tone must be one of 'gain' | 'loss' | 'primary' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DashCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|as|children|key|ref|className|style|children)$/]",
        "message": "<DashCard> doesn't accept that prop. Declared props: variant, padding, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DashCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|net-worth)$/]",
        "message": "<DashCard> variant must be one of 'default' | 'net-worth'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onClose|width|padded|closeLabel|inline|style|children|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: title, onClose, width, padded, closeLabel, inline, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|htmlFor|description|error|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, htmlFor, description, error, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderDropdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|trigger|triggerStyle|width|panelWidth|panelStyle|open|onOpenChange|ariaLabel|children|style|key|ref|className|style|children)$/]",
        "message": "<HeaderDropdown> doesn't accept that prop. Declared props: icon, label, trigger, triggerStyle, width, panelWidth, panelStyle, open, onOpenChange, ariaLabel, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|label|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|reveal|radius|height|invalid|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: icon, reveal, radius, height, invalid, style, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Instrument'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|name|price|change|changePercent|key|ref|className|style|children)$/]",
        "message": "<Instrument> doesn't accept that prop. Declared props: symbol, name, price, change, changePercent."
      },
      {
        "selector": "JSXOpeningElement[name.name='NativeSelect'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|radius|size|invalid|disabled|id|style|key|ref|className|style|children)$/]",
        "message": "<NativeSelect> doesn't accept that prop. Declared props: options, value, onChange, radius, size, invalid, disabled, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NativeSelect'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm)$/]",
        "message": "<NativeSelect> size must be one of 'default' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:points|labels|area|height|style|key|ref|className|style|children)$/]",
        "message": "<PriceChart> doesn't accept that prop. Declared props: points, labels, area, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|placeholder|size|width|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options, value, onChange, placeholder, size, width, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm)$/]",
        "message": "<Select> size must be one of 'default' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|key|ref|className|style|children)$/]",
        "message": "<Separator> doesn't accept that prop. Declared props: orientation."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<Separator> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShareSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|onChange|tone|disabled|style|key|ref|className|style|children)$/]",
        "message": "<ShareSlider> doesn't accept that prop. Declared props: value, max, onChange, tone, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShareSlider'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:buy|sell)$/]",
        "message": "<ShareSlider> tone must be one of 'buy' | 'sell'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute > JSXIdentifier[name!=/^(?:points|height|style|key|ref|className|style|children)$/]",
        "message": "<Sparkline> doesn't accept that prop. Declared props: points, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimeframeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|options|style|key|ref|className|style|children)$/]",
        "message": "<TimeframeToggle> doesn't accept that prop. Declared props: value, onChange, options, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
