FROM python:3.12-slim
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends time && rm -rf /var/lib/apt/lists/*
COPY apps/market-data/db/scripts/python/requirements-ci.txt /tmp/requirements-ci.txt
# pyarrow, duckdb and numpy are large wheels; pip's 15 second read timeout fails them on a slow link.
RUN pip install --no-cache-dir --timeout 120 --retries 10 -r /tmp/requirements-ci.txt
COPY apps/market-data/db /workspace/apps/market-data/db
COPY db/migrations /workspace/db/migrations
ENTRYPOINT ["python"]
