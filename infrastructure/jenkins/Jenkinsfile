pipeline {
    agent any

    tools {
        // Names must match the installations under Manage Jenkins > Tools.
        maven 'Maven'
        nodejs 'NodeJS'
    }

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-21-amazon-corretto'
        PATH = "${JAVA_HOME}/bin:${PATH}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        // The Checkout stage does a depth-1 clone instead.
        skipDefaultCheckout(true)
        timeout(time: 1, unit: 'HOURS')
        timestamps()
        skipStagesAfterUnstable()
    }

    stages {
        stage('Verify Toolchain') {
            steps {
                sh '''
                    set -eu
                    node --version
                    node -e 'const [major, minor] = process.versions.node.split(".").map(Number);
                    if (major !== 24 || minor < 8) { console.error(`Node ${process.versions.node} is unsupported; Node 24.8.0 or later (24.x) is required.`); process.exit(1); }'
                '''
            }
        }

        stage('Preflight') {
            steps {
                sh '''
                    set -eu
                    docker info >/dev/null 2>&1 || { echo "Jenkins cannot reach the Docker daemon." >&2; exit 1; }
                    docker compose version >/dev/null 2>&1 || docker-compose version >/dev/null 2>&1 || { echo "Docker Compose is unavailable." >&2; exit 1; }
                    AVAILABLE_KB="$(df -Pk "$WORKSPACE" | awk 'NR == 2 {print $4}')"
                    [ "$AVAILABLE_KB" -ge 5242880 ] || { echo "At least 5 GiB free workspace storage is required" >&2; exit 1; }
                '''
            }
        }

        stage('Checkout') {
            steps {
                // The reporting tests run as root in Docker; make their output
                // deletable before the checkout cleans the workspace.
                sh '''
                    if [ -d apps/reporting-service ]; then
                        docker run --rm -v "$(pwd)":/ws -w /ws alpine:latest chmod -R a+rwX /ws/apps/reporting-service || true
                    fi
                '''
                script {
                    // Keep the multibranch job's SCM settings and add a depth-1 clone.
                    def shallowExtensions = scm.extensions + [[
                        $class: 'CloneOption',
                        depth: 1,
                        honorRefspec: true,
                        noTags: true,
                        reference: '',
                        shallow: true,
                        timeout: 10
                    ]]
                    checkout([
                        $class: 'GitSCM',
                        branches: scm.branches,
                        doGenerateSubmoduleConfigurations: false,
                        extensions: shallowExtensions,
                        submoduleCfg: [],
                        userRemoteConfigs: scm.userRemoteConfigs
                    ])
                }
            }
        }

        stage('Setup Dependencies') {
            steps {
                sh '''
                    set -eu
                    npm --prefix apps/client-ui ci
                    npm --prefix apps/auth-service ci
                '''
            }
        }

        // Each Java suite uses its own Maven repository. E2E runs afterwards
        // to avoid browser CPU contention.
        stage('Test Suites') {
            failFast true
            parallel {
                stage('Holdings and Trade Service Tests') {
                    steps {
                        dir('apps/holdings-and-trade-service') {
                            sh '''
                                set -eu
                                mvn -B -Dmaven.repo.local="$WORKSPACE/.m2/holdings-and-trade-service" clean test
                                test -s target/site/jacoco/jacoco.xml
                            '''
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'apps/holdings-and-trade-service/target/surefire-reports/**/*, apps/holdings-and-trade-service/target/site/jacoco/**/*',
                                              allowEmptyArchive: true
                            junit testResults: 'apps/holdings-and-trade-service/target/surefire-reports/**/*.xml',
                                  allowEmptyResults: false,
                                  healthScaleFactor: 1.0
                        }
                    }
                }

                stage('Order and Sell Service Tests') {
                    steps {
                        dir('apps/order-and-sell-service') {
                            sh '''
                                set -eu
                                mvn -B -Dmaven.repo.local="$WORKSPACE/.m2/order-and-sell-service" clean test
                                test -s target/site/jacoco/jacoco.xml
                            '''
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'apps/order-and-sell-service/target/surefire-reports/**/*, apps/order-and-sell-service/target/site/jacoco/**/*',
                                              allowEmptyArchive: true
                            junit testResults: 'apps/order-and-sell-service/target/surefire-reports/**/*.xml',
                                  allowEmptyResults: false,
                                  healthScaleFactor: 1.0
                        }
                    }
                }

                stage('Synthetic Market Data Integration') {
                    steps {
                        script {
                            // BUILD_TAG can contain %2F, which Docker rejects in
                            // volume names, so derive a portable tag. The same
                            // value is used by the cleanup below.
                            env.MARKET_TEST_TAG = 'trading-season-market-' + sh(
                                script: 'printf %s "$BUILD_TAG" | sha256sum | cut -c1-16',
                                returnStdout: true
                            ).trim()
                        }
                        sh '''
                            set -eu
                            TEST_TAG="$MARKET_TEST_TAG"
                            DB_CONTAINER="${TEST_TAG}-db"
                            TEST_NETWORK="${TEST_TAG}-network"
                            DB_VOLUME="${TEST_TAG}-db-data"
                            ARCHIVE_VOLUME="${TEST_TAG}-archive"
                            DATABASE_URL="postgresql://trading_season:test-password@${DB_CONTAINER}:5432/trading_season"
                            SCRIPTS=apps/market-data/db/scripts/python
                            SEEDS=/workspace/apps/market-data/db/seeds

                            start_db() {
                                docker run -d --name "$DB_CONTAINER" --network "$TEST_NETWORK" -e POSTGRES_DB=trading_season -e POSTGRES_USER=trading_season -e POSTGRES_PASSWORD=test-password -v "$DB_VOLUME:/var/lib/postgresql/data" postgres:16-alpine
                                until docker exec "$DB_CONTAINER" pg_isready -U trading_season -d trading_season; do sleep 1; done
                            }

                            mkdir -p reports/market-data
                            docker network create "$TEST_NETWORK"
                            docker volume create "$DB_VOLUME"
                            docker volume create "$ARCHIVE_VOLUME"
                            docker build -f infrastructure/docker/Dockerfile.market-data -t "$TEST_TAG" .

                            # Initialize, then restart the database to prove the schema persists.
                            start_db
                            docker run --rm --network "$TEST_NETWORK" "$TEST_TAG" $SCRIPTS/0001-initialize-database.py --database-url "$DATABASE_URL" --disposable-database
                            docker rm -f "$DB_CONTAINER"
                            start_db
                            docker exec "$DB_CONTAINER" psql -U trading_season -d trading_season -Atc "select count(*) from information_schema.tables where table_schema='public';" | grep -Eq '^[1-9][0-9]*$'
                            docker exec "$DB_CONTAINER" psql -U trading_season -d trading_season -Atc "select pg_database_size(current_database());" > reports/market-data/database-before.txt
                            docker exec "$DB_CONTAINER" du -sb /var/lib/postgresql/data > reports/market-data/disk-before.txt
                            AVAILABLE_DISK_GB="$(docker exec "$DB_CONTAINER" df -Pk /var/lib/postgresql/data | awk 'NR==2 {print $4/1048576}')"

                            # Generate two days of data, validate, then import twice (the second import must be a no-op).
                            docker run --rm --network "$TEST_NETWORK" -v "$ARCHIVE_VOLUME:$SEEDS" -v "$PWD/reports/market-data:/reports" --entrypoint /usr/bin/time "$TEST_TAG" -v -o /reports/generation-resources.txt python $SCRIPTS/0002-generate-synthetic-market-data.py --start-date 2026-01-05 --end-date 2026-01-06
                            docker run --rm --network "$TEST_NETWORK" -v "$ARCHIVE_VOLUME:$SEEDS" "$TEST_TAG" $SCRIPTS/0003-validate-synthetic-market-data.py
                            docker run --rm --network "$TEST_NETWORK" -e MARKET_DATA_AVAILABLE_DISK_GB="$AVAILABLE_DISK_GB" -v "$ARCHIVE_VOLUME:$SEEDS" -v "$PWD/reports/market-data:/reports" --entrypoint /usr/bin/time "$TEST_TAG" -v -o /reports/import-resources.txt python $SCRIPTS/0004-import-synthetic-market-data.py --tick-storage parquet --database-url "$DATABASE_URL"
                            docker run --rm --network "$TEST_NETWORK" -e MARKET_DATA_AVAILABLE_DISK_GB="$AVAILABLE_DISK_GB" -v "$ARCHIVE_VOLUME:$SEEDS" "$TEST_TAG" $SCRIPTS/0004-import-synthetic-market-data.py --tick-storage parquet --database-url "$DATABASE_URL"

                            docker exec "$DB_CONTAINER" psql -U trading_season -d trading_season -Atc "select count(*) from market_ticks; select count(*) from candles; select pg_database_size(current_database()); select coalesce(sum(pg_indexes_size(quote_ident(schemaname)||'.'||quote_ident(tablename))),0) from pg_tables where schemaname='public';" > reports/market-data/database-after.txt
                            docker exec "$DB_CONTAINER" du -sb /var/lib/postgresql/data > reports/market-data/disk-after.txt
                            docker run --rm -v "$ARCHIVE_VOLUME:/archive" alpine:3.20 du -sb /archive > reports/market-data/archive.txt
                            test -s reports/market-data/generation-resources.txt
                            test -s reports/market-data/import-resources.txt
                            test -s reports/market-data/database-after.txt
                        '''
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'reports/market-data/**/*', allowEmptyArchive: true
                        }
                        cleanup {
                            sh '''
                                TEST_TAG="$MARKET_TEST_TAG"
                                docker rm -f "${TEST_TAG}-db" 2>/dev/null || true
                                docker volume rm "${TEST_TAG}-db-data" "${TEST_TAG}-archive" 2>/dev/null || true
                                docker network rm "${TEST_TAG}-network" 2>/dev/null || true
                                docker image rm "$TEST_TAG" 2>/dev/null || true
                            '''
                        }
                    }
                }

                stage('Auth Service Tests') {
                    environment {
                        CI = 'true'
                    }
                    steps {
                        // The specs generate an ephemeral RSA keypair, so no JWT credentials are needed.
                        dir('apps/auth-service') {
                            sh '''
                                set -eu
                                npm run test:ci
                                test -s coverage/lcov.info
                                npm run build
                                npm run lint
                            '''
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'apps/auth-service/coverage/**/*, apps/auth-service/reports/**/*',
                                              allowEmptyArchive: true
                            junit testResults: 'apps/auth-service/reports/junit/*.xml',
                                  allowEmptyResults: false,
                                  healthScaleFactor: 1.0
                        }
                    }
                }

                stage('Reporting Service Tests') {
                    environment {
                        CI = 'true'
                    }
                    steps {
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            dir('apps/reporting-service') {
                                // python:3.14-slim: the full image pulls large -dev
                                // libraries and has exhausted agent disk before.
                                sh '''
                                    set -eu
                                    docker run --rm \
                                      -e PYTHONDONTWRITEBYTECODE=1 \
                                      -v "$(pwd)":/app \
                                      -w /app \
                                      python:3.14-slim \
                                      bash -c "
                                        # Runs as root: hand the output back to the jenkins user on any exit.
                                        trap 'chmod -R a+rwX /app' EXIT
                                        set -eu
                                        mkdir -p reports/junit coverage
                                        python -m pip install -q -r requirements.txt
                                        python -m pytest -p no:cacheprovider tests/ -v \
                                          --junit-xml=reports/junit/results.xml \
                                          --cov=. \
                                          --cov-report=xml:coverage/coverage.xml \
                                          --cov-report=html:coverage/htmlcov
                                      "
                                '''
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'apps/reporting-service/coverage/**/*, apps/reporting-service/reports/**/*',
                                              allowEmptyArchive: true
                            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                junit testResults: 'apps/reporting-service/reports/junit/*.xml',
                                      allowEmptyResults: false,
                                      healthScaleFactor: 1.0
                            }
                        }
                    }
                }

                stage('Frontend Tests') {
                    steps {
                        dir('apps/client-ui') {
                            // coverageThresholds in angular.json enforce the coverage floor.
                            sh '''
                                set -eu
                                mkdir -p reports/junit
                                npm test -- --no-watch --coverage --reporters=junit --reporters=default --output-file=reports/junit/ui.xml --coverage-reporters=text --coverage-reporters=html --coverage-reporters=lcovonly --coverage-reporters=cobertura
                                test -s coverage/client-ui/lcov.info
                            '''
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'apps/client-ui/coverage/**/*, apps/client-ui/reports/junit/*.xml',
                                              allowEmptyArchive: true
                            junit testResults: 'apps/client-ui/reports/junit/ui.xml', allowEmptyResults: false
                        }
                    }
                }
            }
        }

        stage('Java API Documentation') {
            when { expression { currentBuild.currentResult == 'SUCCESS' } }
            steps {
                sh '''
                    set -eu
                    for service in holdings-and-trade-service order-and-sell-service; do
                        mvn -B -Dmaven.repo.local="$WORKSPACE/.m2/$service" -f "apps/$service/pom.xml" org.apache.maven.plugins:maven-javadoc-plugin:3.11.2:javadoc
                        test -s "apps/$service/target/reports/apidocs/index.html"
                    done
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'apps/*/target/reports/apidocs/**/*', allowEmptyArchive: false
                }
            }
        }

        stage('Pre-E2E Disk Cleanup') {
            steps {
                // Reports were archived by their own stages.
                sh 'rm -rf apps/holdings-and-trade-service/target apps/order-and-sell-service/target apps/client-ui/coverage'
            }
        }

        stage('End-to-End Tests') {
            environment {
                CI = 'true'
            }
            steps {
                script {
                    env.E2E_TEST_CONTAINER = 'trading-season-e2e-' + sh(
                        script: 'printf %s "$BUILD_TAG" | sha256sum | cut -c1-16',
                        returnStdout: true
                    ).trim()
                }
                dir('apps/client-ui') {
                    sh '''
                        set -eu
                        # Chromium needs system libraries the agent lacks and the
                        # jenkins user cannot install, so the suite runs in a slim
                        # Chromium-only image tagged with the @playwright/test version.
                        PW_VERSION="$(node -p "require('@playwright/test/package.json').version")"
                        PW_IMAGE="trading-season-playwright:${PW_VERSION}"
                        if ! docker image inspect "$PW_IMAGE" >/dev/null 2>&1; then
                            docker build --build-arg PLAYWRIGHT_VERSION="$PW_VERSION" \
                                -t "$PW_IMAGE" - < "$WORKSPACE/infrastructure/docker/Dockerfile.playwright"
                        fi
                        # The workspace (with node_modules) and the Jenkins Node are
                        # mounted in. --user keeps output owned by jenkins and
                        # --ipc=host avoids Chromium crashes from the small /dev/shm.
                        # The API is stubbed, so no backend or database is needed.
                        NODE_HOME="$(dirname "$(dirname "$(command -v node)")")"
                        docker run --rm --name "$E2E_TEST_CONTAINER" \
                            --user "$(id -u):$(id -g)" \
                            --ipc=host \
                            -v "$WORKSPACE:/workspace" \
                            -v "$NODE_HOME:/opt/node:ro" \
                            -e HOME=/tmp \
                            -e PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
                            -e CI=true \
                            -e PATH=/opt/node/bin:/usr/local/bin:/usr/bin:/bin \
                            -w /workspace/apps/client-ui \
                            "$PW_IMAGE" \
                            npm run e2e
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'apps/client-ui/reports/playwright/**/*',
                                      allowEmptyArchive: true
                    junit testResults: 'apps/client-ui/reports/playwright/junit.xml',
                          allowEmptyResults: false,
                          healthScaleFactor: 1.0
                }
            }
        }

        // Nothing depends on this stack, and building its images is the
        // heaviest step, so it runs last once every test has passed.
        stage('Build Local Docker Stack') {
            when {
                expression { currentBuild.currentResult == 'SUCCESS' }
            }
            steps {
                script {
                    // Lets cleanup tell a failed stack build from a failed test.
                    env.LOCAL_STACK_STARTED = 'true'
                }
                sh '''
                    set -eu
                    COMPOSE_FILE="infrastructure/docker-compose/docker-compose.local.yml"
                    COMPOSE_ENV_FILE="infrastructure/docker-compose/.env"
                    PROJECT_NAME="trading-season-local"
                    compose() {
                        sh infrastructure/docker/run-compose.sh --project-name "$PROJECT_NAME" --env-file "$COMPOSE_ENV_FILE" -f "$COMPOSE_FILE" "$@"
                    }

                    # The stack requires JWT keys and the .env that holds them is
                    # gitignored, so mint a keypair for this build only.
                    node apps/auth-service/scripts/generate-dev-keys.mjs > "$COMPOSE_ENV_FILE"

                    # Disposable stack: always start from an empty database.
                    compose down -v --remove-orphans

                    if ! compose up -d --build auth-service client-ui db db-init holdings-and-trade-service kafka order-and-sell-service reporting-service reporting-ui; then
                        compose logs --no-color db-init >&2 || true
                        exit 1
                    fi

                    # kafka-init is started separately because detached startup
                    # of the whole stack can lose a short-lived init container.
                    compose up -d kafka-init
                    compose ps

                    attempt=1
                    while [ "$attempt" -le 60 ]; do
                        INIT_ID="$(compose ps -aq kafka-init)"
                        if [ -n "$INIT_ID" ]; then
                            INIT_STATE="$(docker inspect --format '{{.State.Status}}:{{.State.ExitCode}}' "$INIT_ID")"
                            case "$INIT_STATE" in
                                exited:0) break ;;
                                exited:*)
                                    echo "kafka-init failed ($INIT_STATE)." >&2
                                    docker logs "$INIT_ID" >&2
                                    exit 1
                                    ;;
                            esac
                        fi
                        attempt=$((attempt + 1))
                        sleep 2
                    done
                    if [ "$attempt" -gt 60 ]; then
                        echo "kafka-init did not finish within two minutes." >&2
                        exit 1
                    fi

                    EXPECTED_SERVICES="auth-service client-ui db holdings-and-trade-service kafka order-and-sell-service reporting-consumer reporting-service reporting-ui"
                    RUNNING_SERVICES="$(compose ps --services --filter status=running | sort | tr '\\n' ' ' | sed 's/ $//')"
                    if [ "$RUNNING_SERVICES" != "$EXPECTED_SERVICES" ]; then
                        echo "Expected running services: $EXPECTED_SERVICES" >&2
                        echo "Actual running services:   $RUNNING_SERVICES" >&2
                        compose ps -a
                        echo "===== db-init logs =====" >&2
                        compose logs --no-color db-init >&2 || true
                        for service in $EXPECTED_SERVICES; do
                            case " $RUNNING_SERVICES " in
                                *" $service "*) continue ;;
                            esac
                            echo "===== $service is not running =====" >&2
                            SERVICE_ID="$(compose ps -aq "$service")"
                            if [ -n "$SERVICE_ID" ]; then
                                docker inspect --format 'state={{.State.Status}} exit={{.State.ExitCode}} oom={{.State.OOMKilled}} error={{.State.Error}}' "$SERVICE_ID" >&2
                            fi
                            compose logs --no-color --tail 200 "$service" >&2 || true
                        done
                        exit 1
                    fi

                    check_http() {
                        service="$1"
                        path="$2"
                        expected="$3"
                        port="${4:-8080}"
                        url="http://127.0.0.1:${port}${path}"
                        attempt=1
                        while [ "$attempt" -le 30 ]; do
                            # The slim Python image has no wget.
                            if [ "$service" = reporting-service ]; then
                                compose exec -T "$service" python -c "import sys, urllib.request; sys.stdout.write(urllib.request.urlopen(sys.argv[1], timeout=5).read().decode())" "$url" | grep -F "$expected" >/dev/null && return 0
                            else
                                compose exec -T "$service" wget -qO- "$url" | grep -F "$expected" >/dev/null && return 0
                            fi
                            attempt=$((attempt + 1))
                            sleep 2
                        done
                        echo "HTTP smoke check failed for ${service}${path}." >&2
                        return 1
                    }

                    check_http client-ui / '<app-root'
                    check_http reporting-ui / 'Reporting UI placeholder'
                    check_http reporting-service /health '"status": "healthy"' 8083

                    # Match PartitionCount as a whole tab-delimited field so 3 does not match 30.
                    TOPIC_DESCRIBE="$(compose exec -T kafka /opt/kafka/bin/kafka-topics.sh \
                        --bootstrap-server localhost:9092 --describe --topic trade-events)" || {
                        echo "Topic trade-events does not exist." >&2
                        exit 1
                    }
                    echo "$TOPIC_DESCRIBE"
                    echo "$TOPIC_DESCRIBE" | awk -F'\\t' '
                        /^Topic: /{for (i = 1; i <= NF; i++) if ($i == "PartitionCount: 3") ok = 1}
                        END {exit ok ? 0 : 1}' || {
                        echo "Topic trade-events does not have three partitions." >&2
                        exit 1
                    }

                    # The three consumer groups register only once their service has
                    # started and polled, so wait for all of them and then print the
                    # assignment. This is the build's evidence that every consumer of
                    # trade-events is live, not just that the topic exists.
                    EXPECTED_GROUPS="order-status-pusher portfolio-valuation-capture reporting-ingester"
                    attempt=1
                    while [ "$attempt" -le 60 ]; do
                        GROUPS_LIST="$(compose exec -T kafka /opt/kafka/bin/kafka-consumer-groups.sh \
                            --bootstrap-server localhost:9092 --list 2>/dev/null || true)"
                        missing=""
                        for group in $EXPECTED_GROUPS; do
                            echo "$GROUPS_LIST" | grep -qx "$group" || missing="$missing $group"
                        done
                        [ -z "$missing" ] && break
                        attempt=$((attempt + 1))
                        sleep 2
                    done
                    if [ -n "$missing" ]; then
                        echo "Consumer groups not registered on trade-events within two minutes:$missing" >&2
                        for group in $missing; do
                            case "$group" in
                                order-status-pusher) service=order-and-sell-service ;;
                                portfolio-valuation-capture) service=holdings-and-trade-service ;;
                                reporting-ingester) service=reporting-consumer ;;
                            esac
                            echo "===== $service logs =====" >&2
                            compose logs --no-color --tail 100 "$service" >&2 || true
                        done
                        exit 1
                    fi
                    echo "===== Kafka consumer groups on trade-events ====="
                    compose exec -T kafka /opt/kafka/bin/kafka-consumer-groups.sh \
                        --bootstrap-server localhost:9092 --describe --all-groups

                    docker ps --format 'table {{.Names}}\\t{{.Status}}\\t{{.Image}}\\t{{.Ports}}'
                '''
            }
        }

        stage('Kafka End-to-End Flow') {
            when {
                expression { currentBuild.currentResult == 'SUCCESS' }
            }
            steps {
                sh '''
                    set -eu
                    COMPOSE_FILE="infrastructure/docker-compose/docker-compose.local.yml"
                    COMPOSE_ENV_FILE="infrastructure/docker-compose/.env"
                    PROJECT_NAME="trading-season-local"
                    compose() {
                        sh infrastructure/docker/run-compose.sh --project-name "$PROJECT_NAME" --env-file "$COMPOSE_ENV_FILE" -f "$COMPOSE_FILE" "$@"
                    }
                    EVIDENCE_DIR="reports/kafka-end-to-end"
                    EVIDENCE="$EVIDENCE_DIR/evidence.txt"
                    mkdir -p "$EVIDENCE_DIR"
                    : > "$EVIDENCE"
                    note() {
                        echo "$1"
                        echo "$1" >> "$EVIDENCE"
                    }

                    note "===== Kafka end-to-end: one order through trade-events and its three consumers ====="

                    # The build database is empty, so give the order something to buy.
                    compose exec -T db psql -U trading_season -d trading_season -v ON_ERROR_STOP=1 -q -c \
                        "INSERT INTO instruments (ticker, name, asset_class, market, currency, is_tradable) VALUES ('CIEQ', 'CI Equity', 'Equity', 'US', 'USD', true);"
                    note "[KAFKA-E2E] instrument: CIEQ inserted for this build"

                    # Registers a trader, opens the order stream, places the order and checks
                    # each consumer's effect from inside the stack network.
                    status=0
                    compose exec -T reporting-consumer python - < infrastructure/jenkins/kafka-end-to-end.py > "$EVIDENCE_DIR/flow.txt" 2>&1 || status=$?
                    cat "$EVIDENCE_DIR/flow.txt"
                    cat "$EVIDENCE_DIR/flow.txt" >> "$EVIDENCE"
                    if [ "$status" -ne 0 ]; then
                        echo "Kafka end-to-end flow failed (exit $status); service logs follow." >&2
                        for service in order-and-sell-service holdings-and-trade-service reporting-consumer; do
                            echo "===== $service logs =====" >&2
                            compose logs --no-color --tail 100 "$service" >&2 || true
                        done
                        exit 1
                    fi
                    IDS="$(grep '^.KAFKA-E2E. orderId=' "$EVIDENCE_DIR/flow.txt" | tr '=' ' ')"
                    ORDER_ID="$(echo "$IDS" | awk '{print $3}')"
                    ACCOUNT_ID="$(echo "$IDS" | awk '{print $5}')"

                    # The producer and each consumer announce what they did in their own logs.
                    log_line() {
                        attempt=1
                        while [ "$attempt" -le 45 ]; do
                            LINE="$(compose logs --no-color "$1" 2>/dev/null | grep -F "$2" | tail -1 || true)"
                            if [ -n "$LINE" ]; then
                                note "[KAFKA-E2E] $3: ${LINE#*| }"
                                return 0
                            fi
                            attempt=$((attempt + 1))
                            sleep 1
                        done
                        echo "No log line matching '$2' from $1 within 45 seconds." >&2
                        return 1
                    }
                    log_line order-and-sell-service "Published trade event orderId=$ORDER_ID status=ACCEPTED" "producer log, ACCEPTED"
                    log_line order-and-sell-service "Published trade event orderId=$ORDER_ID status=FILLED" "producer log, FILLED"
                    log_line order-and-sell-service "Pushed order status for account $ACCOUNT_ID to 1 open stream(s)" "order-status-pusher log"
                    log_line holdings-and-trade-service "Captured portfolio valuation for account $ACCOUNT_ID" "portfolio-valuation-capture log"
                    log_line reporting-consumer "Stored trade event orderId=$ORDER_ID status=FILLED" "reporting-ingester log"

                    # Finally every group must have consumed everything the order published.
                    attempt=1
                    while [ "$attempt" -le 30 ]; do
                        DESCRIBE="$(compose exec -T kafka /opt/kafka/bin/kafka-consumer-groups.sh --bootstrap-server localhost:9092 --describe --all-groups 2>/dev/null || true)"
                        if echo "$DESCRIBE" | awk '$2 == "trade-events" && $6 != "0" && $6 != "-" {bad = 1} END {exit bad}'; then
                            break
                        fi
                        attempt=$((attempt + 1))
                        sleep 1
                    done
                    echo "$DESCRIBE" | tee -a "$EVIDENCE"
                    if [ "$attempt" -gt 30 ]; then
                        echo "A consumer group still has lag on trade-events after 30 seconds." >&2
                        exit 1
                    fi
                    note "[KAFKA-E2E] consumer groups: every group has consumed everything on trade-events (lag 0)"
                    note "===== Kafka end-to-end: PASSED ====="
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/kafka-end-to-end/**/*', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        cleanup {
            // Isolate each cleanup step so a failure does not skip the rest,
            // including workspace deletion.
            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                script {
                    def resourceCleanupStatus = sh(script: '''
                        set +e
                        docker info >/dev/null 2>&1 || { echo "Docker is unavailable; test resource cleanup could not run." >&2; exit 1; }
                        cleanup_failed=0
                        remove_resource() {
                            resource_kind="$1"
                            resource_name="$2"
                            shift 2
                            if docker "$resource_kind" inspect "$resource_name" >/dev/null 2>&1; then
                                docker "$resource_kind" rm "$@" "$resource_name" || cleanup_failed=1
                            fi
                        }
                        if [ -n "${E2E_TEST_CONTAINER:-}" ]; then
                            remove_resource container "$E2E_TEST_CONTAINER" -f
                        fi
                        if [ -n "${MARKET_TEST_TAG:-}" ]; then
                            remove_resource container "${MARKET_TEST_TAG}-db" -f
                            remove_resource volume "${MARKET_TEST_TAG}-db-data"
                            remove_resource volume "${MARKET_TEST_TAG}-archive"
                            remove_resource network "${MARKET_TEST_TAG}-network"
                            remove_resource image "$MARKET_TEST_TAG"
                        fi
                        exit "$cleanup_failed"
                    ''', returnStatus: true)
                    if (resourceCleanupStatus != 0) {
                        echo "Test resource cleanup failed with status ${resourceCleanupStatus}."
                    }
                    // A successful stack is left running; only tear down a failed one.
                    if (currentBuild.currentResult != 'SUCCESS' && env.LOCAL_STACK_STARTED == 'true') {
                        def composeCleanupStatus = sh(
                            script: 'sh infrastructure/docker/run-compose.sh --project-name trading-season-local --env-file infrastructure/docker-compose/.env -f infrastructure/docker-compose/docker-compose.local.yml down -v --remove-orphans',
                            returnStatus: true
                        )
                        if (composeCleanupStatus != 0) {
                            echo "Local stack cleanup failed with status ${composeCleanupStatus}."
                        }
                    }
                }
            }
            // Keep the Playwright image, Maven and npm caches, and up to 2 GiB
            // of Docker build cache when the agent will still have 6 GiB free
            // after the workspace is deleted; otherwise start the next build cold.
            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                script {
                    def cacheCleanupStatus = sh(script: '''
                        set +e
                        PW_VERSION=""
                        if [ -f node_modules/@playwright/test/package.json ]; then
                            PW_VERSION="$(node -p "require('@playwright/test/package.json').version" 2>/dev/null)"
                        fi
                        # Drop Playwright images for other versions and the official images.
                        docker image ls trading-season-playwright --format '{{.Tag}}' | while read -r tag; do
                            [ "$tag" = "$PW_VERSION" ] || docker image rm "trading-season-playwright:$tag" >/dev/null 2>&1
                        done
                        docker image ls mcr.microsoft.com/playwright --format '{{.Repository}}:{{.Tag}}' | while read -r image; do
                            docker image rm "$image" >/dev/null 2>&1
                        done
                        docker image prune -f >/dev/null 2>&1
                        docker builder prune -f --keep-storage=2gb 2>/dev/null || docker builder prune -af 2>/dev/null

                        KEEP_CACHES_MIN_KB=$((6 * 1024 * 1024))
                        AVAILABLE_KB="$(df -Pk "$WORKSPACE" | awk 'NR == 2 {print $4}')"
                        WORKSPACE_KB="$(du -sk "$WORKSPACE" 2>/dev/null | cut -f1)"
                        PROJECTED_KB=$((${AVAILABLE_KB:-0} + ${WORKSPACE_KB:-0}))
                        if [ "$PROJECTED_KB" -ge "$KEEP_CACHES_MIN_KB" ]; then
                            echo "Keeping dependency caches; $((PROJECTED_KB / 1024 / 1024)) GiB will be free after workspace cleanup."
                            exit 0
                        fi

                        echo "Only $((PROJECTED_KB / 1024 / 1024)) GiB will be free after workspace cleanup; removing all caches."
                        if [ -n "$PW_VERSION" ]; then
                            docker image rm "trading-season-playwright:$PW_VERSION" >/dev/null 2>&1
                        fi
                        docker builder prune -af 2>/dev/null
                        exit 0
                    ''', returnStatus: true)
                    if (cacheCleanupStatus != 0) {
                        echo "Dependency-cache cleanup failed with status ${cacheCleanupStatus}; preserving the original build result."
                    }
                }
            }
            script {
                try {
                    // Reports were archived by the stage post blocks.
                    deleteDir()
                } catch (err) {
                    echo "Workspace cleanup failed: ${err}; preserving the original build result."
                }
            }
        }
    }
}
