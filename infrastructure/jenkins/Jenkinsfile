pipeline {
    agent any
    
    tools {
        // Must match a Maven installation configured in Jenkins under
        // Manage Jenkins > Tools.
        maven 'Maven'
        // This Jenkins tool must be configured with Node 24.x at 24.8.0 or
        // later. Angular 21.2.x supports Node 24.x. Reconfigure the Jenkins
        // NodeJS tool if version mismatches occur.
        nodejs 'NodeJS'
    }

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-21-amazon-corretto'
        PATH = "${JAVA_HOME}/bin:${PATH}"
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        // Avoid Declarative Pipeline's implicit full-history checkout. The
        // explicit Checkout stage below keeps only the current branch tip.
        skipDefaultCheckout(true)
        timeout(time: 1, unit: 'HOURS')
        timestamps()
    }
    
    stages {
        stage('Verify Toolchain') {
            steps {
                sh '''
                    set -eu
                    node --version
                    npm --version
                    node -e 'const [major, minor] = process.versions.node.split(".").map(Number);
                    const supported = major === 24 && minor >= 8;
                    if (!supported) { console.error(`Node ${process.versions.node} is unsupported. This project requires Node 24.x at 24.8.0 or later, which is compatible with Angular 21.2.x. Reconfigure the Jenkins NodeJS tool named "NodeJS" to use a supported Node 24 release.`); process.exit(1); }'
                '''
            }
        }

        stage('Docker Services') {
            steps {
                sh '''
                    set -eu
                    echo "Running Docker services on the Jenkins VM:"
                    if ! command -v docker >/dev/null 2>&1; then
                        echo "Docker CLI is unavailable; later market-data and Playwright stages require it." >&2
                        exit 1
                    fi
                    if ! docker info >/dev/null 2>&1; then
                        echo "Jenkins cannot access the Docker daemon; check the daemon and socket permissions." >&2
                        exit 1
                    fi
                    if docker compose version >/dev/null 2>&1; then
                        docker compose version
                    elif command -v docker-compose >/dev/null 2>&1; then
                        docker-compose version
                    else
                        echo "Docker Compose is unavailable; rebuild the Jenkins image or install the docker-compose command." >&2
                        exit 1
                    fi
                    docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}\t{{.Ports}}'
                '''
            }
        }

        stage('Early Disk Cleanup') {
            steps {
                sh '''
                    set +e
                    echo "Performing early disk cleanup to free space for build..."
                    
                    # Stop and remove trading-season containers
                    echo "Stopping trading-season-local containers..."
                    docker compose -f infrastructure/docker-compose/docker-compose.local.yml down 2>/dev/null || true
                    
                    # Clean old Maven cache if present (older than 30 days)
                    echo "Removing old Maven cache..."
                    if [ -d ~/.m2/repository ]; then
                        find ~/.m2/repository -type d -mtime +30 -exec rm -rf {} + 2>/dev/null || true
                    fi
                    
                    # Clean old npm cache if present
                    echo "Removing old npm cache..."
                    npm cache clean --force 2>/dev/null || true
                    
                    echo "✓ Early disk cleanup complete"
                    set -e
                '''
            }
        }

        stage('Checkout') {
            steps {
                script {
                    // Preserve the multibranch job's repository, credentials,
                    // refspec, branch selection, and configured extensions,
                    // then add a depth-1 clone behavior for this checkout.
                    def shallowExtensions = scm.extensions + [[
                        $class: 'CloneOption',
                        depth: 1,
                        honorRefspec: true,
                        noTags: true,
                        reference: '',
                        shallow: true,
                        timeout: 10
                    ]]
                    checkout([
                        $class: 'GitSCM',
                        branches: scm.branches,
                        doGenerateSubmoduleConfigurations: false,
                        extensions: shallowExtensions,
                        submoduleCfg: [],
                        userRemoteConfigs: scm.userRemoteConfigs
                    ])
                }
                echo "✓ Repository checked out"
            }
        }

        stage('Setup Dependencies') {
            steps {
                script {
                    if (sh(script: 'command -v node > /dev/null 2>&1', returnStatus: true) == 0) {
                        sh '''
                            set -eu
                            echo " Installing application dependencies..."
                            node --version
                            npm --version
                        '''
                        // Use npm ci for reproducible, locked installations. The UI
                        // and auth service are independent npm projects, each with
                        // its own lockfile and its own node_modules, so the two
                        // installs cannot race each other.
                        parallel(
                            'client-ui': {
                                sh '''
                                    set -eu
                                    npm --prefix apps/client-ui ci --prefer-offline --fund=false
                                '''
                            },
                            'auth-service': {
                                sh '''
                                    set -eu
                                    npm --prefix apps/auth-service ci --prefer-offline --fund=false
                                '''
                            }
                        )
                        echo "✓ Application dependencies installed"
                    } else {
                        echo "  Node.js not available, skipping npm setup"
                    }
                }
                // apps/market-data holds only Python and SQL since the
                // microservice split. The Java code lives in the two Spring Boot
                // services below, so the cache is warmed from their poms.
                sh '''
                    set -eu
                    # Aggressive Maven cache cleanup to avoid dependency resolution issues
                    echo " Clearing Maven cache..."
                    rm -rf ~/.m2/repository/org/junit/platform ~/.m2/repository/org/apache/maven/plugins/maven-surefire-plugin
                    rm -rf ~/.m2/repository/org/junit
                    # Warm up Maven cache with fresh dependencies
                    for service in apps/holdings-and-trade-service apps/order-and-sell-service; do
                        mvn -B -f "$service/pom.xml" dependency:resolve dependency:resolve-plugins -U
                    done
                    echo "✓ Maven dependencies cached"
                '''
                // This pre-resolve is what makes it safe for Holdings and Trade
                // and Order and Sell to run `mvn clean test` concurrently below:
                // without it, both would race to download first-use dependencies
                // into this same shared ~/.m2/repository, and Maven does not
                // guarantee safe concurrent writes into one local repository.
            }
        }

        // The five suites below are mutually independent: each reads and
        // writes only its own app/report directories, and Synthetic Market
        // Data Integration derives build-scoped Docker resource names so it
        // never collides with another branch. Running them inside `parallel`
        // cuts wall-clock time; each nested stage still publishes its own
        // results from `post`, so one branch's failure cannot skip Archive
        // and Publish for the others. Setup Dependencies already warmed the
        // shared Maven local repository for both Java services, so the
        // concurrent `mvn clean test` runs below should only need cache
        // reads rather than racing on new downloads.
        //
        // End-to-End Tests was tried as a sixth branch here. Playwright
        // enforces its own per-test timeouts, and under the added CPU
        // contention from its own Docker image build/run on top of these
        // five, those timeouts tripped and failed the suite outright. It
        // runs as its own sequential stage after this one instead.
        stage('Test Suites') {
            parallel {
                stage('Holdings and Trade Service Tests') {
                    steps {
                        dir('apps/holdings-and-trade-service') {
                            sh '''
                                echo " Running Holdings and Trade Service Tests..."
                                mvn -B clean test
                                echo "✓ Holdings and Trade Service tests completed"
                            '''
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'apps/holdings-and-trade-service/target/surefire-reports/**/*, apps/holdings-and-trade-service/target/site/jacoco/**/*',
                                              allowEmptyArchive: true
                            junit testResults: 'apps/holdings-and-trade-service/target/surefire-reports/**/*.xml',
                                  allowEmptyResults: true,
                                  healthScaleFactor: 1.0
                            echo "✓ Holdings and Trade Service test results published"
                        }
                    }
                }

                stage('Order and Sell Service Tests') {
                    steps {
                        dir('apps/order-and-sell-service') {
                            sh '''
                                echo " Running Order and Sell Service Tests..."
                                mvn -B clean test
                                echo "✓ Order and Sell Service tests completed"
                            '''
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'apps/order-and-sell-service/target/surefire-reports/**/*, apps/order-and-sell-service/target/site/jacoco/**/*',
                                              allowEmptyArchive: true
                            junit testResults: 'apps/order-and-sell-service/target/surefire-reports/**/*.xml',
                                  allowEmptyResults: true,
                                  healthScaleFactor: 1.0
                            echo "✓ Order and Sell Service test results published"
                        }
                    }
                }

                stage('Synthetic Market Data Integration') {
                    steps {
                        script {
                            // Multibranch BUILD_TAG values can contain encoded branch
                            // separators such as %2F, which Docker rejects in named
                            // volumes. Hash the complete tag to retain build isolation
                            // while keeping every Docker resource name portable.
                            // Derived once and reused by the cleanup in `post`: two
                            // copies of this expression can drift apart, and cleanup
                            // that computes a different name silently leaks the
                            // containers, volumes, and network it was meant to remove.
                            env.MARKET_TEST_TAG = 'trading-season-market-' + sh(
                                script: 'printf %s "$BUILD_TAG" | sha256sum | cut -c1-16',
                                returnStdout: true
                            ).trim()
                        }
                        sh '''
                            set -eu
                            TEST_TAG="$MARKET_TEST_TAG"
                            DB_CONTAINER="${TEST_TAG}-db"
                            TEST_NETWORK="${TEST_TAG}-network"
                            DB_VOLUME="${TEST_TAG}-db-data"
                            ARCHIVE_VOLUME="${TEST_TAG}-archive"
                            mkdir -p reports/market-data
                            docker network create "$TEST_NETWORK"
                            docker volume create "$DB_VOLUME"
                            docker volume create "$ARCHIVE_VOLUME"
                            docker build -f infrastructure/docker/Dockerfile.market-data -t "$TEST_TAG" .
                            docker run -d --name "$DB_CONTAINER" --network "$TEST_NETWORK" -e POSTGRES_DB=trading_season -e POSTGRES_USER=trading_season -e POSTGRES_PASSWORD=test-password -v "$DB_VOLUME:/var/lib/postgresql/data" postgres:16-alpine
                            until docker exec "$DB_CONTAINER" pg_isready -U trading_season -d trading_season; do sleep 1; done
                            DATABASE_URL="postgresql://trading_season:test-password@${DB_CONTAINER}:5432/trading_season"
                            docker run --rm --network "$TEST_NETWORK" "$TEST_TAG" apps/market-data/db/scripts/0001-initialize-database.py --database-url "$DATABASE_URL" --disposable-database
                            docker rm -f "$DB_CONTAINER"
                            docker run -d --name "$DB_CONTAINER" --network "$TEST_NETWORK" -e POSTGRES_DB=trading_season -e POSTGRES_USER=trading_season -e POSTGRES_PASSWORD=test-password -v "$DB_VOLUME:/var/lib/postgresql/data" postgres:16-alpine
                            until docker exec "$DB_CONTAINER" pg_isready -U trading_season -d trading_season; do sleep 1; done
                            docker exec "$DB_CONTAINER" psql -U trading_season -d trading_season -Atc "select count(*) from information_schema.tables where table_schema='public';" | grep -Eq '^[1-9][0-9]*$'
                            docker exec "$DB_CONTAINER" psql -U trading_season -d trading_season -Atc "select pg_database_size(current_database());" > reports/market-data/database-before.txt
                            docker exec "$DB_CONTAINER" du -sb /var/lib/postgresql/data > reports/market-data/disk-before.txt
                            AVAILABLE_DISK_GB="$(docker exec "$DB_CONTAINER" df -Pk /var/lib/postgresql/data | awk 'NR==2 {print $4/1048576}')"
                            docker run --rm --network "$TEST_NETWORK" -e TEST_DATABASE_URL="$DATABASE_URL" -e MARKET_DATA_AVAILABLE_DISK_GB="$AVAILABLE_DISK_GB" -v "$ARCHIVE_VOLUME:/workspace/apps/market-data/db/seeds" -v "$PWD/reports/market-data:/reports" "$TEST_TAG" -m pytest apps/market-data/db/tests --junitxml=/reports/junit.xml
                            docker run --rm --network "$TEST_NETWORK" -v "$ARCHIVE_VOLUME:/workspace/apps/market-data/db/seeds" -v "$PWD/reports/market-data:/reports" --entrypoint /usr/bin/time "$TEST_TAG" -v -o /reports/generation-resources.txt python apps/market-data/db/scripts/0002-generate-synthetic-market-data.py --start-date 2026-01-05 --end-date 2026-01-06
                            docker run --rm --network "$TEST_NETWORK" -v "$ARCHIVE_VOLUME:/workspace/apps/market-data/db/seeds" "$TEST_TAG" apps/market-data/db/scripts/0003-validate-synthetic-market-data.py
                            docker run --rm --network "$TEST_NETWORK" -e MARKET_DATA_AVAILABLE_DISK_GB="$AVAILABLE_DISK_GB" -v "$ARCHIVE_VOLUME:/workspace/apps/market-data/db/seeds" -v "$PWD/reports/market-data:/reports" --entrypoint /usr/bin/time "$TEST_TAG" -v -o /reports/import-resources.txt python apps/market-data/db/scripts/0004-import-synthetic-market-data.py --tick-storage parquet --database-url "$DATABASE_URL"
                            docker run --rm --network "$TEST_NETWORK" -e MARKET_DATA_AVAILABLE_DISK_GB="$AVAILABLE_DISK_GB" -v "$ARCHIVE_VOLUME:/workspace/apps/market-data/db/seeds" "$TEST_TAG" apps/market-data/db/scripts/0004-import-synthetic-market-data.py --tick-storage parquet --database-url "$DATABASE_URL"
                            docker exec "$DB_CONTAINER" psql -U trading_season -d trading_season -Atc "select count(*) from market_ticks; select count(*) from candles; select pg_database_size(current_database()); select coalesce(sum(pg_indexes_size(quote_ident(schemaname)||'.'||quote_ident(tablename))),0) from pg_tables where schemaname='public';" > reports/market-data/database-after.txt
                            docker exec "$DB_CONTAINER" du -sb /var/lib/postgresql/data > reports/market-data/disk-after.txt
                            docker run --rm -v "$ARCHIVE_VOLUME:/archive" alpine:3.20 du -sb /archive > reports/market-data/archive.txt
                        '''
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'reports/market-data/**/*', allowEmptyArchive: true
                            junit testResults: 'reports/market-data/junit.xml', allowEmptyResults: true
                            sh '''
                                TEST_TAG="$MARKET_TEST_TAG"
                                docker rm -f "${TEST_TAG}-db" 2>/dev/null || true
                                docker volume rm "${TEST_TAG}-db-data" "${TEST_TAG}-archive" 2>/dev/null || true
                                docker network rm "${TEST_TAG}-network" 2>/dev/null || true
                                docker image rm "$TEST_TAG" 2>/dev/null || true
                            '''
                        }
                    }
                }

                stage('Auth Service Tests') {
                    // Deliberately NOT wrapped in a `command -v npm` check. A missing
                    // toolchain is a broken pipeline, not a reason to pass: the build
                    // fails instead of quietly skipping, which is what the acceptance
                    // criteria require.
                    environment {
                        CI = 'true'
                    }
                    steps {
                        // catchError marks this stage and the build as failed but lets
                        // other parallel branches finish, so one red suite cannot hide
                        // another.
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            // No JWT credentials needed: the specs generate an ephemeral
                            // RSA keypair per run. A committed or injected test key would
                            // eventually be copied into a deployment config.
                            dir('apps/auth-service') {
                                sh '''
                                    set -eu
                                    echo "Running Auth Service Tests (Vitest)..."
                                    npm run test:ci
                                    echo "✓ Auth service tests completed"
                                '''
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'apps/auth-service/coverage/**/*, apps/auth-service/reports/**/*',
                                              allowEmptyArchive: true
                            // allowEmptyResults: false is what makes "tests never ran"
                            // a failure rather than a silent pass. It throws to do so,
                            // and an uncaught throw in `post` would otherwise abort the
                            // whole run; catchError keeps the build red without taking
                            // the other parallel branches down with it.
                            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                junit testResults: 'apps/auth-service/reports/junit/*.xml',
                                      allowEmptyResults: false,
                                      healthScaleFactor: 1.0
                            }
                        }
                    }
                }

                stage('Frontend Tests') {
                    steps {
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            dir('apps/client-ui') {
                                sh '''
                                    set -eu
                                    echo " Running Frontend Tests (Angular + Vitest)..."
                                    # --no-watch and --coverage are options of the
                                    # @angular/build:unit-test builder. Vitest's own
                                    # --run is not: `ng test --run` fails with
                                    # "Unknown argument: run" before any test executes.
                                    # coverageThresholds in angular.json fails the run
                                    # below the agreed floor.
                                    npm test -- --no-watch --coverage
                                    echo "✓ Frontend tests completed"
                                '''
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'apps/client-ui/coverage/**/*',
                                              allowEmptyArchive: true
                        }
                    }
                }
            }
        }

        stage('Pre-E2E Disk Cleanup') {
            steps {
                sh '''
                    set +e
                    echo "Aggressive disk cleanup before E2E tests (large Playwright image pull)..."

                    # Remove test artifacts from prior stages that consumed disk
                    rm -rf apps/holdings-and-trade-service/target
                    rm -rf apps/order-and-sell-service/target
                    rm -rf apps/client-ui/coverage

                    # Report current disk state
                    BEFORE_KB="$(df -Pk "$WORKSPACE" | awk 'NR == 2 {print $4}')"
                    echo "Available disk before cleanup: $((BEFORE_KB / 1024 / 1024)) GiB"

                    # Remove unused Docker images, dangling layers, and build cache
                    docker image prune -af >/dev/null 2>&1
                    docker builder prune -af >/dev/null 2>&1

                    # Clean npm and Maven caches
                    npm cache clean --force >/dev/null 2>&1
                    find ~/.m2/repository -type f -name "*.jar" -o -name "*.pom" | xargs rm -f 2>/dev/null || true

                    # Report freed space
                    AFTER_KB="$(df -Pk "$WORKSPACE" | awk 'NR == 2 {print $4}')"
                    FREED_MB=$(( (AFTER_KB - BEFORE_KB) / 1024 ))
                    echo "✓ Available disk after cleanup: $((AFTER_KB / 1024 / 1024)) GiB (freed ~$((FREED_MB > 0 ? FREED_MB : 0)) MB)"

                    set -e
                '''
            }
        }

        stage('End-to-End Tests') {
            environment {
                CI = 'true'
            }
            steps {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    dir('apps/client-ui') {
                        sh '''
                            set -eu
                            echo " Running Frontend E2E Tests (Playwright)..."
                            # Headless Chromium needs GTK/ATK shared libraries this agent
                            # does not carry (libatk-1.0.so.0 and friends), and installing
                            # them needs root: `playwright install --with-deps` shells out
                            # to sudo apt-get, which the jenkins user cannot run. So the
                            # suite runs inside a container that carries those libraries.
                            # The official Playwright image also ships Firefox and WebKit,
                            # which this Chromium-only suite never uses, so the pipeline
                            # builds a slim image holding only chromium-headless-shell and
                            # ffmpeg. The tag is read from the installed @playwright/test
                            # so it cannot drift out of step with it -- browser builds are
                            # only guaranteed to match the Playwright version that
                            # installed them. The image is built once per version and
                            # reused while the agent has room for it.
                            PW_VERSION="$(node -p "require('@playwright/test/package.json').version")"
                            PW_IMAGE="trading-season-playwright:${PW_VERSION}"
                            if ! docker image inspect "$PW_IMAGE" >/dev/null 2>&1; then
                                echo "Building $PW_IMAGE..."
                                docker build --build-arg PLAYWRIGHT_VERSION="$PW_VERSION" \
                                    -t "$PW_IMAGE" - < "$WORKSPACE/infrastructure/docker/Dockerfile.playwright"
                            fi
                            docker image ls "$PW_IMAGE" --format 'Playwright image {{.Repository}}:{{.Tag}} is {{.Size}}'
                            # The whole workspace is mounted rather than just this app so
                            # client-ui's node_modules, installed on this Linux agent in
                            # Setup Dependencies, is reused as is.
                            # The Jenkins NodeJS tool is mounted in and put first on PATH,
                            # so the container builds with the same Node that Verify
                            # Toolchain checked rather than whatever the image carries.
                            NODE_HOME="$(dirname "$(dirname "$(command -v node)")")"
                            # --user keeps dist/ and reports/ owned by jenkins rather than
                            # root, which would break the next build's checkout and the
                            # archiveArtifacts step below. HOME gives npm a writable cache.
                            # --ipc=host avoids the Chromium crashes that the default
                            # 64MB /dev/shm causes under Docker.
                            # Playwright starts its own server on 4200 and waits for it;
                            # the API tier is stubbed at the network boundary, so no
                            # database or backend service is required.
                            docker run --rm \
                                --user "$(id -u):$(id -g)" \
                                --ipc=host \
                                -v "$WORKSPACE:/workspace" \
                                -v "$NODE_HOME:/opt/node:ro" \
                                -e HOME=/tmp \
                                -e CI=true \
                                -e PATH=/opt/node/bin:/usr/local/bin:/usr/bin:/bin \
                                -w /workspace/apps/client-ui \
                                "$PW_IMAGE" \
                                npm run e2e
                            echo "✓ End-to-end tests completed"
                        '''
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'apps/client-ui/reports/playwright/**/*',
                                      allowEmptyArchive: true
                    // allowEmptyResults: false for the same reason as the auth stage:
                    // a missing report means the suite never ran, which is a failure.
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                        junit testResults: 'apps/client-ui/reports/playwright/junit.xml',
                              allowEmptyResults: false,
                              healthScaleFactor: 1.0
                    }
                }
            }
        }

        // No test depends on this stack: E2E stubs the API and market data
        // starts its own database. Building its five images is the heaviest
        // step in the pipeline, so it runs last, once the test stages are
        // green. Every branch builds it, so the docker ps output below reports
        // the services for the branch under test rather than whatever the
        // previous build left running.
        stage('Build Local Docker Stack') {
            when {
                expression { currentBuild.currentResult == 'SUCCESS' }
            }
            steps {
                script {
                    // Lets final cleanup tell a failed stack build apart from
                    // a failed test, which must leave the previous stack alone.
                    env.LOCAL_STACK_STARTED = 'true'
                }
                sh '''
                    set -eu
                    COMPOSE_FILE="infrastructure/docker-compose/docker-compose.local.yml"
                    PROJECT_NAME="trading-season-local"
                    # The local stack requires JWT_PRIVATE_KEY and JWT_PUBLIC_KEY
                    # with no default, and the .env that normally holds them is
                    # gitignored, so a fresh checkout has nothing to interpolate
                    # and compose exits before building anything. Mint a keypair
                    # for this build alone, for the same reason the auth specs do:
                    # a key committed or injected for CI is a key that eventually
                    # reaches a deployment. The workspace is deleted in `post`.
                    COMPOSE_ENV_FILE="infrastructure/docker-compose/.env"
                    node apps/auth-service/scripts/generate-dev-keys.mjs > "$COMPOSE_ENV_FILE"
                    
                    # Source the generated keys into the current shell environment.
                    # We need both the .env file (for docker-compose --env-file) and
                    # the shell environment (for docker-compose to inherit via subprocess).
                    eval "$(grep -E '^JWT_|^DB_PASSWORD' "$COMPOSE_ENV_FILE" 2>/dev/null || true | sed 's/^/export /')"
                    
                    # Verify the keys were exported
                    if [ -z "${JWT_PRIVATE_KEY:-}" ]; then
                        echo "[ERROR] JWT_PRIVATE_KEY not exported" >&2
                        exit 1
                    fi
                    if [ -z "${JWT_PUBLIC_KEY:-}" ]; then
                        echo "[ERROR] JWT_PUBLIC_KEY not exported" >&2
                        exit 1
                    fi
                    echo "[INFO] JWT keys exported successfully"

                    echo "Building and starting the local application stack..."
                    env JWT_PRIVATE_KEY="$JWT_PRIVATE_KEY" JWT_PUBLIC_KEY="$JWT_PUBLIC_KEY" JWT_ISSUER="${JWT_ISSUER:-https://auth.dualeapa.local}" \
                    bash infrastructure/docker/run-compose.sh \
                        --project-name "$PROJECT_NAME" \
                        --env-file "$COMPOSE_ENV_FILE" \
                        -f "$COMPOSE_FILE" \
                        up -d --build

                    echo "Local application services after startup:"
                    bash infrastructure/docker/run-compose.sh \
                        --project-name "$PROJECT_NAME" \
                        --env-file "$COMPOSE_ENV_FILE" \
                        -f "$COMPOSE_FILE" \
                        ps

                    # kafka-init exits, so it must not appear in the running-service
                    # comparison below. Unlike db-init, nothing declares
                    # depends_on: service_completed_successfully against it, so
                    # `up -d` returns while it is still starting. docker inspect
                    # rather than `docker compose wait`, which needs Compose 2.24
                    # and run-compose.sh may fall back to legacy docker-compose.
                    attempt=1
                    while [ "$attempt" -le 60 ]; do
                        INIT_ID="$(sh infrastructure/docker/run-compose.sh \
                            --project-name "$PROJECT_NAME" \
                            -f "$COMPOSE_FILE" \
                            ps -aq kafka-init)"
                        if [ -n "$INIT_ID" ]; then
                            INIT_STATE="$(docker inspect --format '{{.State.Status}}:{{.State.ExitCode}}' "$INIT_ID")"
                            case "$INIT_STATE" in
                                exited:0) break ;;
                                exited:*)
                                    echo "kafka-init failed ($INIT_STATE)." >&2
                                    docker logs "$INIT_ID" >&2
                                    exit 1
                                    ;;
                            esac
                        fi
                        attempt=$((attempt + 1))
                        sleep 2
                    done
                    if [ "$attempt" -gt 60 ]; then
                        echo "kafka-init did not finish within two minutes." >&2
                        exit 1
                    fi

                    EXPECTED_SERVICES="auth-service client-ui db holdings-and-trade-service kafka order-and-sell-service reporting-service reporting-ui"
                    RUNNING_SERVICES="$(sh infrastructure/docker/run-compose.sh \
                        --project-name "$PROJECT_NAME" \
                        --env-file "$COMPOSE_ENV_FILE" \
                        -f "$COMPOSE_FILE" \
                        ps --services --filter status=running | sort | tr '\n' ' ' | sed 's/ $//')"
                    if [ "$RUNNING_SERVICES" != "$EXPECTED_SERVICES" ]; then
                        echo "Expected running services: $EXPECTED_SERVICES" >&2
                        echo "Actual running services:   $RUNNING_SERVICES" >&2
                        bash infrastructure/docker/run-compose.sh \
                            --project-name "$PROJECT_NAME" \
                            --env-file "$COMPOSE_ENV_FILE" \
                            -f "$COMPOSE_FILE" \
                            logs --no-color --tail 100
                        exit 1
                    fi

                    check_http() {
                        service="$1"
                        path="$2"
                        expected="$3"
                        attempt=1
                        while [ "$attempt" -le 30 ]; do
                            if bash infrastructure/docker/run-compose.sh \
                                --project-name "$PROJECT_NAME" \
                                --env-file "$COMPOSE_ENV_FILE" \
                                -f "$COMPOSE_FILE" \
                                exec -T "$service" wget -qO- "http://127.0.0.1:8080${path}" | grep -F "$expected" >/dev/null; then
                                return 0
                            fi
                            attempt=$((attempt + 1))
                            sleep 2
                        done
                        echo "HTTP smoke check failed for ${service}${path}." >&2
                        return 1
                    }

                    check_http client-ui / '<app-root'
                    check_http reporting-ui / 'Reporting UI placeholder'
                    check_http reporting-service /health '"status":"ok"'

                    # check_http cannot be reused: it hardcodes 127.0.0.1:8080
                    # inside the container. A missing topic makes kafka-topics.sh
                    # exit non-zero by itself; the awk asserts the partition count
                    # as a whole tab-delimited field, because a substring match on
                    # 'PartitionCount: 3' also matches 'PartitionCount: 30'. The
                    # header line starts at column 0 while per-partition lines
                    # start with a tab, so ^Topic: anchors to the header.
                    TOPIC_DESCRIBE="$(sh infrastructure/docker/run-compose.sh \
                        --project-name "$PROJECT_NAME" \
                        -f "$COMPOSE_FILE" \
                        exec -T kafka /opt/kafka/bin/kafka-topics.sh \
                            --bootstrap-server localhost:9092 \
                            --describe --topic trade-events)" || {
                        echo "Topic trade-events does not exist." >&2
                        exit 1
                    }
                    echo "$TOPIC_DESCRIBE"
                    echo "$TOPIC_DESCRIBE" | awk -F'\t' '
                        /^Topic: /{for (i = 1; i <= NF; i++) if ($i == "PartitionCount: 3") ok = 1}
                        END {exit ok ? 0 : 1}' || {
                        echo "Topic trade-events does not have three partitions." >&2
                        exit 1
                    }

                    # -a on a narrow filter rather than on the listing below:
                    # kafka-init exits once the topic is created, so it is
                    # invisible to a running-only listing, and its exit status is
                    # the evidence that topic creation actually ran.
                    echo "Kafka broker and topic setup:"
                    docker ps -a --filter name=kafka --format 'table {{.Names}}\t{{.Status}}'

                    echo "All Docker containers after startup:"
                    docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}\t{{.Ports}}'
                    echo "Local application stack is running on host ports 3001, 4200, 4300, 5432, 8081, 8082, 8083, and 29092."
                '''
            }
        }
    }
    
    post {
        always {
            script {
                def dockerStatus = sh(script: '''
                        echo "Running Docker services after the Jenkins build:"
                        docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}\t{{.Ports}}'
                    ''', returnStatus: true)
                if (dockerStatus != 0) {
                    echo "Final Docker service inspection failed with status ${dockerStatus}; preserving the original build result."
                }
            }
            script {
                def containerCleanupStatus = sh(script: '''
                    set +e
                    echo "Cleaning up Docker containers from this build..."
                    
                    # Stop and remove trading-season containers from this build
                    docker ps -a --filter "label=com.docker.compose.project=trading-season-local" --format "{{.ID}}" | while read -r container_id; do
                        echo "Stopping container: $container_id"
                        docker stop "$container_id" 2>/dev/null || true
                        echo "Removing container: $container_id"
                        docker rm "$container_id" 2>/dev/null || true
                    done
                    
                    # Remove any dangling containers from market-data tests
                    docker ps -a --filter "label=trading-season-market" --format "{{.ID}}" | while read -r container_id; do
                        echo "Stopping test container: $container_id"
                        docker stop "$container_id" 2>/dev/null || true
                        echo "Removing test container: $container_id"
                        docker rm "$container_id" 2>/dev/null || true
                    done
                    
                    # Remove unnamed/orphaned trading-season containers
                    docker ps -a --filter "ancestor=trading-season-market-*" --format "{{.ID}}" 2>/dev/null | while read -r container_id; do
                        echo "Removing orphaned container: $container_id"
                        docker rm "$container_id" 2>/dev/null || true
                    done
                    
                    echo "✓ Docker container cleanup complete"
                    set -e
                ''', returnStatus: true)
                if (containerCleanupStatus != 0) {
                    echo "Docker container cleanup had issues but build continues (status ${containerCleanupStatus})."
                }
            }
            script {
                if (currentBuild.currentResult == 'SUCCESS') {
                    echo 'Preserving the trading-season-local application stack after the successful build.'
                } else {
                    def composeCleanupStatus = sh(
                        script: 'docker compose -f infrastructure/docker-compose/docker-compose.local.yml down',
                        returnStatus: true
                    )
                    if (composeCleanupStatus != 0) {
                        echo "Local application stack cleanup failed with status ${composeCleanupStatus}; preserving the original build result."
                    }
                }
            }
            // Keep the Maven and npm caches, the Playwright image, and up to
            // 2 GiB of Docker build cache so the next build does not download
            // them again. When the agent would drop below the free-space floor
            // after workspace deletion, fall back to removing all of them.
            script {
                def cacheCleanupStatus = sh(script: '''
                    set +e
                    PW_VERSION=""
                    if [ -f node_modules/@playwright/test/package.json ]; then
                        PW_VERSION="$(node -p "require('@playwright/test/package.json').version" 2>/dev/null)"
                    fi
                    # Only the current Playwright version's image is worth
                    # keeping. Older tags, and the much larger official images
                    # earlier builds pulled, are always removed.
                    docker image ls trading-season-playwright --format '{{.Tag}}' | while read -r tag; do
                        [ "$tag" = "$PW_VERSION" ] || docker image rm "trading-season-playwright:$tag" >/dev/null 2>&1
                    done
                    docker image ls mcr.microsoft.com/playwright --format '{{.Repository}}:{{.Tag}}' | while read -r image; do
                        docker image rm "$image" >/dev/null 2>&1
                    done
                    docker image prune -f >/dev/null 2>&1
                    docker builder prune -f --keep-storage=2gb 2>/dev/null || docker builder prune -af 2>/dev/null

                    # One GiB above the 5 GiB Disk Preflight floor. A warm build
                    # needs far less than the cold build that floor was sized for.
                    KEEP_CACHES_MIN_KB=$((6 * 1024 * 1024))
                    AVAILABLE_KB="$(df -Pk "$WORKSPACE" | awk 'NR == 2 {print $4}')"
                    WORKSPACE_KB="$(du -sk "$WORKSPACE" 2>/dev/null | cut -f1)"
                    PROJECTED_KB=$((${AVAILABLE_KB:-0} + ${WORKSPACE_KB:-0}))
                    if [ "$PROJECTED_KB" -ge "$KEEP_CACHES_MIN_KB" ]; then
                        echo "Keeping dependency caches; $((PROJECTED_KB / 1024 / 1024)) GiB will be free after workspace cleanup."
                        exit 0
                    fi

                    echo "Only $((PROJECTED_KB / 1024 / 1024)) GiB will be free after workspace cleanup; removing all caches so the next build starts cold."
                    if [ -n "$PW_VERSION" ]; then
                        docker image rm "trading-season-playwright:$PW_VERSION" >/dev/null 2>&1
                    fi
                    docker builder prune -af 2>/dev/null
                    rm -rf ~/.m2/repository ~/.npm
                    exit 0
                ''', returnStatus: true)
                if (cacheCleanupStatus != 0) {
                    echo "Dependency-cache cleanup failed with status ${cacheCleanupStatus}; preserving the original build result."
                }
                try {
                    // Stage post blocks have already archived their reports.
                    // Removing the checkout prevents Git history, dependencies,
                    // and generated output from accumulating between builds.
                    deleteDir()
                } catch (err) {
                    echo "Workspace cleanup failed: ${err}; preserving the original build result."
                }
            }
            echo "✓ Build caches pruned and workspace cleaned"
        }
        
        success {
            echo " All Tests PASSED"
        }
        
        failure {
            echo " Tests FAILED - Review test results above"
        }
        
        unstable {
            echo "  Build is UNSTABLE - Some tests may have failed or timed out"
        }
    }
}
