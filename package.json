{
  "name": "trading-season",
  "version": "0.1.0",
  "description": "trading season - Full-stack trading simulation platform",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix apps/client-ui && npm install --prefix apps/reporting-ui",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "workspaces": [
    "apps/client-ui",
    "apps/reporting-ui",
    "packages/shared-ui-components",
    "packages/api-contracts"
  ],
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "keywords": [
    "trading",
    "simulation",
    "angular",
    "spring-boot",
    "postgresql",
    "monorepo"
  ],
  "engines": {
    "node": "^24.8.0",
    "npm": "11.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/trading-season.git"
  },
  "author": "DuaLEAPa Team",
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "overrides": {
    "vite": "8.1.5",
    "smol-toml": "^1.7.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true,
    "nx@23.2.1": true
  }
}
