{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json"
  ],
  "tasks": {
    "build": {
      "outputs": [
        "dist/**",
        "build/**",
        ".next/**"
      ],
      "cache": false
    },
    "test": {
      "outputs": [
        "coverage/**"
      ],
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
